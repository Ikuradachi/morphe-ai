# Morphe Workspace Environment Variables
# Copy this to .env and fill in your values:
#   cp .env.example .env

# --- Active Patch Repository ---
# Managed automatically via `./select-repo.sh [repo_name]`
# Default fallback is `morphe-patches` if unset
MORPHE_PATCHES_DIR=

# --- GitHub Authentication (Gradle & Packages) ---
# GitHub Personal Access Token (PAT) with `read:packages` scope
# Used for resolving Morphe patcher dependencies from GitHub Packages
# Also configured in ~/.gradle/gradle.properties as gpr.user and gpr.key
GITHUB_TOKEN=

# --- Reverse Engineering & Native Analysis Toolchains ---
# Path to Ghidra installation (automatically detected/configured by ./update-tools.sh)
GHIDRA_INSTALL_DIR=

# Path to REA headless JADX MCP jar (automatically downloaded by ./update-tools.sh)
REA_JADX_MCP_JAR=

# --- Remote Decompilation via Kaggle (Optional) ---
# Kaggle API token (for remote JADX decompilation of large APKs)
# Get from: https://www.kaggle.com/settings → API → Create New Token
KAGGLE_API_TOKEN=

# Kaggle kernel ID (your-username/notebook-name)
# Create a private notebook on Kaggle called "jadx-apk-decompiler"
KAGGLE_KERNEL_ID=your-username/jadx-apk-decompiler

# --- Optional CLI Configurations ---
# Override CLI data root (default: morphe-data/)
# MORPHE_DATA_DIR=morphe-data/
